+"""Bounded raw evidence journal, deliberately unable to produce eligible bars.
+
+Payloads are SDK protobuf serializations, not original network packet bytes.
+No SDK, network, trading, database or detector imports. One owner thread required.
+"""
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import time
+
+SYMBOLS = ('US.SPY', 'US.QQQ')
+
+
+def encode(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=True, allow_nan=False).encode('ascii')
+
+
+def digest(value):
+    return hashlib.sha256(encode(value)).hexdigest()
+
+
+class CaptureStopped(RuntimeError):
+    pass
+
+
+class Journal:
+    """Exclusive session, bounded bytes/records/time, fsync before acknowledgement.
+
+    Local wall-versus-monotonic checks detect divergence, not UTC accuracy.
+    A clean seal verifies local integrity, never source truth or market completeness.
+    """
+    def __init__(self, directory, metadata, clock=None):
+        self.clock = clock or (lambda: (time.time_ns(), time.monotonic_ns()))
+        self.start_wall, self.start_mono = self.clock()
+        self.previous_wall, self.previous_mono = self.start_wall, self.start_mono
+        self.last_receipt_wall, self.last_receipt_mono = self.start_wall, self.start_mono
+        self.last = {s: self.start_mono for s in SYMBOLS}
+        self.count = self.size = 0
+        self.max_records, self.max_bytes = 5000, 10 * 1024 * 1024
+        self.closed = False
+        self.stopped = None
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=False, exist_ok=False)
+        self.manifest = dict(schema=1, mode='RAW_ONLY', strategy_status='DATA_BLOCKED',
+                             symbols=SYMBOLS, duration_ns=300_000_000_000,
+                             silence_ns=30_000_000_000, max_records=self.max_records,
+                             max_bytes=self.max_bytes, max_payload_bytes=65536,
+                             start_wall_ns=self.start_wall, start_mono_ns=self.start_mono,
+                             metadata=metadata)
+        self.chain = digest(self.manifest)
+        self._save('manifest.json', self.manifest)
+        self.file = (self.directory / 'receipts.jsonl').open('xb')
+
+    def _save(self, name, value):
+        with (self.directory / name).open('xb') as handle:
+            handle.write(encode(value) + b'\n')
+            handle.flush()
+            os.fsync(handle.fileno())
+
+    def stop(self, reason):
+        self.stopped = self.stopped or reason
+        raise CaptureStopped(self.stopped)
+
+    def check(self):
+        if self.closed: raise CaptureStopped('CLOSED')
+        if self.stopped: raise CaptureStopped(self.stopped)
+        wall, mono = self.clock()
+        if (mono < self.previous_mono or wall < self.previous_wall
+                or abs((wall-self.start_wall)-(mono-self.start_mono)) > 250_000_000):
+            self.stop('CLOCK_DIVERGENCE')
+        self.previous_wall, self.previous_mono = wall, mono
+        if mono-self.start_mono >= self.manifest['duration_ns']: self.stop('TIME_LIMIT')
+        if any(mono-last > self.manifest['silence_ns'] for last in self.last.values()):
+            self.stop('SYMBOL_SILENCE')
+        return wall, mono
+
+    def append(self, symbol, source_stamps, payload, *, received=None):
+        wall, mono = self.check()
+        if received is None: received = (wall, mono)
+        rw, rm = received
+        if (rm < self.last_receipt_mono or rw < self.last_receipt_wall or rm > mono or rw > wall
+                or abs((rw-self.start_wall)-(rm-self.start_mono)) > 250_000_000):
+            self.stop('RECEIPT_CLOCK')
+        if symbol not in SYMBOLS: self.stop('SYMBOL_SCOPE')
+        if not isinstance(payload, bytes) or not payload or len(payload) > 65536:
+            self.stop('PAYLOAD_LIMIT')
+        if (not isinstance(source_stamps, tuple) or not source_stamps
+                or len(source_stamps) > 100
+                or any(not isinstance(s, str) or len(s) > 128 for s in source_stamps)):
+            self.stop('SCHEMA')
+        if self.count >= self.max_records: self.stop('RECORD_LIMIT')
+        record = dict(sequence=self.count+1, symbol=symbol, source_stamps=source_stamps,
+                      received_wall_ns=rw, received_mono_ns=rm,
+                      journal_wall_ns=wall, journal_mono_ns=mono,
+                      finality='UNKNOWN', strategy_status='DATA_BLOCKED',
+                      payload_kind='SDK_PROTOBUF_SERIALIZATION',
+                      payload_b64=base64.b64encode(payload).decode('ascii'),
+                      payload_sha256=hashlib.sha256(payload).hexdigest(), previous=self.chain)
+        hashed = digest(record)
+        line = encode(dict(record, hash=hashed)) + b'\n'
+        if self.size+len(line) > self.max_bytes: self.stop('BYTE_LIMIT')
+        try:
+            if self.file.write(line) != len(line): raise OSError('short write')
+            self.file.flush()
+            os.fsync(self.file.fileno())
+        except OSError:
+            self.stop('WRITE_FAILURE')
+        self.count += 1
+        self.size += len(line)
+        self.chain = hashed
+        self.last[symbol] = rm
+        self.last_receipt_wall, self.last_receipt_mono = rw, rm
+        return self.count
+
+    def finish(self, reason):
+        summary = dict(schema=1, manifest_sha256=digest(self.manifest),
+                       records=self.count, bytes=self.size, last_hash=self.chain,
+                       stop_reason=self.stopped or reason,
+                       strategy_status='DATA_BLOCKED', finality='UNKNOWN',
+                       completeness='NOT_ESTABLISHED')
+        self.close()
+        self._save('summary.json', summary)
+        return summary
+
+    def close(self):
+        if not self.closed:
+            self.closed = True
+            if hasattr(self, 'file'): self.file.close()
+
+
+def verify(directory, *, cutoff_ns=None, sequence=None):
+    """Validate entire sealed capture before returning a receipt-as-of prefix.
+
+    This is a receipt view, not a point-in-time market state or durable-commit view.
+    Hash chain detects accidental edits; no signature or adversarial authenticity.
+    """
+    directory = Path(directory)
+    manifest = json.loads((directory / 'manifest.json').read_bytes())
+    summary = json.loads((directory / 'summary.json').read_bytes())
+    if (type(manifest.get('schema')) is not int or manifest['schema'] != 1
+            or manifest.get('mode') != 'RAW_ONLY'
+            or manifest.get('strategy_status') != 'DATA_BLOCKED'
+            or manifest.get('symbols') != list(SYMBOLS)
+            or type(summary.get('schema')) is not int or summary['schema'] != 1
+            or summary.get('finality') != 'UNKNOWN'
+            or summary.get('completeness') != 'NOT_ESTABLISHED'):
+        raise ValueError('Unsupported seal safety metadata')
+    for name, value in (('sequence', sequence), ('cutoff_ns', cutoff_ns)):
+        if value is not None and (type(value) is not int or value < 0):
+            raise ValueError(f'{name} must be a nonnegative integer')
+    start = (manifest.get('start_wall_ns'), manifest.get('start_mono_ns'))
+    if any(type(v) is not int or v < 0 for v in start):
+        raise ValueError('Invalid capture clock origin')
+    previous_receipt = previous_journal = start
+    chain = digest(manifest)
+    records = []
+    size = 0
+    with (directory / 'receipts.jsonl').open('rb') as handle:
+        for line in handle:
+            size += len(line)
+            if size > 10*1024*1024 or len(records) >= 5000 or not line.endswith(b'\n'):
+                raise ValueError('Capture bounds or framing')
+            r = json.loads(line)
+            receipt = (r.get('received_wall_ns'), r.get('received_mono_ns'))
+            journal = (r.get('journal_wall_ns'), r.get('journal_mono_ns'))
+            if (type(r.get('sequence')) is not int
+                    or any(type(v) is not int or v < 0 for v in receipt + journal)
+                    or any(v < old for v, old in zip(receipt, previous_receipt))
+                    or any(v < old for v, old in zip(journal, previous_journal))
+                    or any(v > saved for v, saved in zip(receipt, journal))
+                    or any(abs((pair[0]-start[0])-(pair[1]-start[1])) > 250_000_000
+                           for pair in (receipt, journal))):
+                raise ValueError('Invalid capture receipt chronology')
+            previous_receipt, previous_journal = receipt, journal
+            hashed = r.pop('hash')
+            payload = base64.b64decode(r['payload_b64'], validate=True)
+            if (r['previous'] != chain or digest(r) != hashed
+                    or r['sequence'] != len(records)+1 or r['symbol'] not in SYMBOLS
+                    or r['finality'] != 'UNKNOWN' or r['strategy_status'] != 'DATA_BLOCKED'
+                    or not 0 < len(payload) <= 65536
+                    or hashlib.sha256(payload).hexdigest() != r['payload_sha256']):
+                raise ValueError('Capture integrity')
+            chain = hashed
+            records.append(dict(r, hash=hashed))
+    if (summary['manifest_sha256'] != digest(manifest)
+            or summary['records'] != len(records) or summary['bytes'] != size
+            or summary['last_hash'] != chain or summary['strategy_status'] != 'DATA_BLOCKED'):
+        raise ValueError('Seal mismatch')
+    return tuple(r for r in records
+                 if (cutoff_ns is None or r['received_wall_ns'] <= cutoff_ns)
+                 and (sequence is None or r['sequence'] <= sequence))
diff --git a/research/feed_contract/field_path_audit.py b/research/feed_contract/field_path_audit.py
new file mode 100644
index 0000000..d2d1254
--- /dev/null
+++ b/research/feed_contract/field_path_audit.py
@@ -0,0 +1,94 @@
+"""Offline field trajectories: expose excursions hidden by endpoint equality."""
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+from revision_impact import analyze
+
+
+def _state(row, field):
+    return dict(present=field in row['source'], value=copy.deepcopy(row['source'].get(field)))
+
+
+def _ref(row):
+    return {k: row[k] for k in ('sequence', 'row_index')}
+
+
+def audit(directory, *, before, after, decoder=None):
+    """Audit a fixed baseline against every later observation, including reversions.
+
+    First-seen-after-baseline groups have no baseline; their initial values are
+    not revisions. References resolve into the embedded, sealed impact evidence.
+    All comparisons use the inherited decoded-field presence/value semantics.
+    """
+    evidence = analyze(directory, before=before, after=after, decoder=decoder)
+    baseline = {(g['symbol'], g['source_label']): g['last_observed']
+                for g in evidence['before']['groups']}
+    paths = []
+    for group in evidence['after']['groups']:
+        key = group['symbol'], group['source_label']
+        initial = baseline.get(key)
+        history = group['history']
+        # Sequence/row position, rather than label time or value equality.
+        later = [r for r in history if initial is None or
+                 (r['sequence'], r['row_index']) > (initial['sequence'], initial['row_index'])]
+        anchor = initial if initial is not None else history[0]
+        rows = [anchor] + (later if initial is not None else later[1:])
+        fields = sorted(set().union(*(r['source'] for r in rows)))
+        field_paths = []
+        for field in fields:
+            start = _state(anchor, field)
+            previous = anchor
+            changes = []
+            for row in rows[1:]:
+                old, new = _state(previous, field), _state(row, field)
+                if old != new:
+                    changes.append(dict(previous=_ref(previous), observation=_ref(row),
+                                        before=old, after=new, returns_to_anchor=new == start))
+                previous = row
+            end = _state(rows[-1], field)
+            classification = ('UNCHANGED' if not changes else
+                              'RETURNED_TO_ANCHOR' if end == start else 'NET_CHANGED')
+            field_paths.append(dict(field=field, anchor=start, last_observed=end,
+                                    classification=classification, change_count=len(changes),
+                                    return_count=sum(c['returns_to_anchor'] for c in changes),
+                                    changes=changes))
+        paths.append(dict(symbol=key[0], source_label=key[1],
+                          baseline_available=initial is not None, anchor=_ref(anchor),
+                          last_observed=_ref(rows[-1]), observations_after_baseline=len(later),
+                          fields=field_paths, status='PROVISIONAL', finality='UNKNOWN',
+                          strategy_status='DATA_BLOCKED'))
+    result = {k: copy.deepcopy(evidence[k]) for k in
+              ('status', 'finality', 'strategy_status', 'boundary_semantics',
+               'completeness', 'provider_accuracy', 'adjustment_factors', 'provenance')}
+    result['provenance']['field_path_source_sha256'] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    result.update(schema=1, mode='OFFLINE_FIELD_PATH_AUDIT', paths=paths, evidence=evidence,
+                  counts={name: sum(f['classification'] == name for p in paths for f in p['fields'])
+                          for name in ('UNCHANGED', 'RETURNED_TO_ANCHOR', 'NET_CHANGED')})
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('capture', type=Path)
+    parser.add_argument('--before-sequence', type=int, required=True)
+    parser.add_argument('--after-sequence', type=int, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args(argv)
+    try:
+        result = audit(args.capture, before={'sequence': args.before_sequence},
+                       after={'sequence': args.after_sequence})
+        encoded = json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + '\n'
+        with args.output.open('x', encoding='utf-8') as handle:
+            handle.write(encoded)
+    except Exception as exc:
+        print(f'DATA_BLOCKED: field path audit failed: {exc}', file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/research/feed_contract/opend_capture.py b/research/feed_contract/opend_capture.py
new file mode 100644
index 0000000..9180ea7
--- /dev/null
+++ b/research/feed_contract/opend_capture.py
@@ -0,0 +1,202 @@
+"""Opt-in raw-only quote capture for pinned Moomoo 10.11.7108.
+
+One localhost connection and one subscription; no history, account queries,
+trade context, credentials, detector or dashboard imports. No automatic retries.
+Run under --supervise for a hard process lifetime bound, including SDK calls.
+"""
+import argparse
+from datetime import datetime, time as daytime
+import hashlib
+from importlib.metadata import distribution, version
+import json
+import os
+from pathlib import Path
+import queue
+import socket
+import subprocess
+import sys
+import threading
+import time
+from zoneinfo import ZoneInfo
+
+from capture import Journal, CaptureStopped, SYMBOLS, verify
+
+
+def local_identity():
+    """Pin this reviewed Windows installation without reading login/config data."""
+    binary = Path(os.environ['APPDATA']) / 'moomoo_OpenD' / 'moomoo_OpenD.exe'
+    binary_hash = hashlib.sha256(binary.read_bytes()).hexdigest()
+    if binary_hash != '3c2c5065c8f18dece54dc2c208317721a0c16821cfcd8fa21e45255faa38d738':
+        raise RuntimeError('Unreviewed OpenD binary; connection blocked')
+    package = distribution('moomoo-api')
+    sources = ('moomoo/common/open_context_base.py',
+               'moomoo/quote/open_quote_context.py',
+               'moomoo/quote/quote_response_handler.py')
+    return dict(opend_binary_sha256=binary_hash,
+                sdk_source_sha256={p: hashlib.sha256(Path(package.locate_file(p)).read_bytes()).hexdigest()
+                                   for p in sources})
+
+
+def regular_hours(now):
+    eastern = now.astimezone(ZoneInfo('America/New_York'))
+    # Time-of-day restriction only. Exchange holiday/halt authority remains UNKNOWN.
+    return eastern.weekday() < 5 and daytime(9, 30) <= eastern.time() < daytime(16)
+
+
+def worker(directory):
+    if version('moomoo-api') != '10.11.7108':
+        raise RuntimeError('Unreviewed SDK version; connection blocked')
+    if not regular_hours(datetime.now().astimezone()):
+        raise RuntimeError('Outside regular-hours time window; connection blocked')
+    identity = local_identity()
+    # Load native SDK dependencies before opening even the reachability socket.
+    from moomoo.quote.open_quote_context import OpenQuoteContext
+    from moomoo.quote.quote_response_handler import CurKlineHandlerBase, SysNotifyHandlerBase
+    from moomoo.common.constant import RET_OK, RET_ERROR, SubType, Session
+    # No provider request: a single TCP reachability probe before SDK construction.
+    with socket.create_connection(('127.0.0.1', 11111), timeout=2):
+        pass
+
+    pending = queue.Queue(maxsize=128)
+    fault = threading.Event()
+    fault_reason = ['PROVIDER_EVENT']
+
+    def fail(reason):
+        fault_reason[0] = reason
+        fault.set()
+
+    class Quotes(OpenQuoteContext):
+        def _wait_reconnect(self, wait_reconnect_interval=6):
+            # The pinned SDK also retries initial failures before on_connect.
+            # Permit its constructor's first scheduling call only.
+            if getattr(self, '_capture_connect_scheduled', False):
+                self._auto_reconnect = False
+                fail('INITIAL_CONNECT_FAILED')
+                return
+            self._capture_connect_scheduled = True
+            return super()._wait_reconnect(wait_reconnect_interval)
+
+        def on_connect(self, conn_id, info):
+            self._auto_reconnect = False  # pinned SDK implementation reviewed
+            return super().on_connect(conn_id, info)
+
+        def on_disconnect(self, conn_id, reason, msg):
+            self._auto_reconnect = False
+            fail('DISCONNECTED')
+            return super().on_disconnect(conn_id, reason, msg)
+
+    class Candles(CurKlineHandlerBase):
+        def on_recv_rsp(self, pb):
+            received = (time.time_ns(), time.monotonic_ns())
+            if fault.is_set(): return RET_ERROR, 'capture stopped'
+            try:
+                if pb.ByteSize() > 65536: raise ValueError('payload limit')
+                raw = pb.SerializeToString()
+                ret, table = super().on_recv_rsp(pb)
+                if ret != RET_OK or table.empty: raise ValueError('response/schema')
+                symbols = tuple(table['code'].unique())
+                if len(symbols) != 1 or symbols[0] not in SYMBOLS:
+                    raise ValueError('symbol scope')
+                if set(table['k_type']) != {SubType.K_1M}: raise ValueError('interval')
+                pending.put_nowait((symbols[0], tuple(table['time_key']), raw, received))
+                return RET_OK, None
+            except queue.Full:
+                fail('QUEUE_OVERFLOW')
+            except Exception:
+                fail('CALLBACK_SCHEMA_OR_SCOPE')
+            return RET_ERROR, 'capture stopped'
+
+    class Notifications(SysNotifyHandlerBase):
+        def on_recv_rsp(self, pb):
+            # Fail on all system notifications; do not retain broad account fields.
+            fail('SYSTEM_NOTIFICATION')
+            return RET_OK, None
+
+    journal = Journal(directory, dict(
+        mode='LIVE_RAW', provider='moomoo', sdk_version='10.11.7108',
+        endpoint='127.0.0.1:11111', interval='K_1M', session='RTH',
+        user_attestation='API_ACCESS_AND_LOCAL_RETENTION_PERMITTED',
+        subscription='ONE_REQUEST_NO_CACHED_FIRST_PUSH',
+        source_time_mapping='UNKNOWN', calendar_authority='UNKNOWN',
+        utc_clock_accuracy='UNKNOWN', entitlement_independently_verified=False,
+        adjustment='OBSERVE_PROTOBUF_REHABTYPE_ONLY_NOT_CERTIFIED',
+        identity=identity,
+        code_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        journal_code_sha256=hashlib.sha256(Path(__file__).with_name('capture.py').read_bytes()).hexdigest()))
+    context = None
+    reason = 'RUN_LIMIT'
+    subscription_accepted = False
+    try:
+        context = Quotes(host='127.0.0.1', port=11111, is_async_connect=True)
+        context.set_sync_query_connect_timeout(5)
+        context.set_handler(Candles())
+        context.set_handler(Notifications())
+        if fault.is_set(): raise CaptureStopped(fault_reason[0])
+        ret, _ = context.subscribe(list(SYMBOLS), [SubType.K_1M],
+                                   is_first_push=False, subscribe_push=True,
+                                   extended_time=False, session=Session.RTH)
+        if fault.is_set(): raise CaptureStopped(fault_reason[0])
+        if ret != RET_OK: raise CaptureStopped('SUBSCRIPTION_REJECTED')
+        subscription_accepted = True
+        deadline = time.monotonic() + 120
+        while time.monotonic() < deadline:
+            if fault.is_set(): raise CaptureStopped(fault_reason[0])
+            if not regular_hours(datetime.now().astimezone()):
+                raise CaptureStopped('SESSION_TIME_END')
+            journal.check()
+            try: symbol, stamps, raw, received = pending.get(timeout=0.1)
+            except queue.Empty: continue
+            journal.append(symbol, stamps, raw, received=received)
+    except CaptureStopped as exc:
+        reason = str(exc)
+    except Exception:
+        reason = 'SDK_OR_CAPTURE_FAILURE'  # no broad provider/account payload in report
+    finally:
+        fault.set()
+        # Seal evidence before potentially blocking SDK cleanup. The supervisor
+        # marks timeout separately; a journal seal alone never means clean teardown.
+        try:
+            summary = journal.finish(reason)
+        finally:
+            journal.close()
+            if context is not None: context.close()
+    verify(directory)
+    return dict(summary, subscription_accepted=subscription_accepted)
+
+
+def supervise(directory):
+    """Hard 300-second worker limit. Raw files stay local and are never uploaded."""
+    directory = Path(directory).resolve()
+    if directory.exists(): raise FileExistsError(directory)
+    if not directory.parent.is_dir(): raise FileNotFoundError(directory.parent)
+    log = directory.parent / (directory.name + '.worker.log')
+    result = directory.parent / (directory.name + '.supervisor.json')
+    # Reserve both evidence names before starting any child/network operation.
+    with result.open('x', encoding='utf-8') as report, log.open('xb') as output:
+        process = subprocess.Popen([sys.executable, '-B', str(Path(__file__).resolve()),
+                                    '--worker', str(directory)],
+                                   stdout=output, stderr=subprocess.STDOUT)
+        timed_out = False
+        try: code = process.wait(timeout=300)
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            process.kill()
+            code = process.wait(timeout=10)
+        report.write(json.dumps(dict(returncode=code, timed_out=timed_out,
+                                     strategy_status='DATA_BLOCKED',
+                                     capture_directory=str(directory)), sort_keys=True))
+        report.flush()
+        os.fsync(report.fileno())
+    return 1 if timed_out or code else 0
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument('--supervise', type=Path)
+    mode.add_argument('--worker', type=Path, help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    if args.supervise: raise SystemExit(supervise(args.supervise))
+    outcome = worker(args.worker)
+    print(json.dumps(outcome, sort_keys=True))
+    raise SystemExit(0 if outcome['stop_reason'] == 'RUN_LIMIT' else 2)
diff --git a/research/feed_contract/provisional_replay.py b/research/feed_contract/provisional_replay.py
new file mode 100644
index 0000000..0ac3db8
--- /dev/null
+++ b/research/feed_contract/provisional_replay.py
@@ -0,0 +1,168 @@
+"""Offline receipt replay. No market-time interpretation or eligible candle output."""
+import argparse
+import ast
+import base64
+import copy
+import hashlib
+from importlib.metadata import distribution, version
+import json
+import math
+from pathlib import Path
+import sys
+
+from capture import verify
+
+
+def protobuf_decoder():
+    """Read descriptor literals only; never import/execute the moomoo package.
+
+    The installed, reviewed SDK supplies schemas, not a quote context. Private
+    descriptor pool avoids global SDK registrations. No installation/download.
+    """
+    from google.protobuf import descriptor_pool, message_factory
+    if version('moomoo-api') != '10.11.7108':
+        raise ValueError('Unreviewed schema version')
+    package = distribution('moomoo-api')
+    pool = descriptor_pool.DescriptorPool()
+    hashes = {}
+    for name in ('Common', 'Qot_Common', 'Qot_UpdateKL'):
+        path = Path(package.locate_file(f'moomoo/common/pb/{name}_pb2.py'))
+        raw = path.read_bytes()
+        tree = ast.parse(raw)
+        literals = [node.value.args[0] for node in tree.body
+                    if isinstance(node, ast.Assign)
+                    and any(isinstance(t, ast.Name) and t.id == 'DESCRIPTOR'
+                            for t in node.targets)
+                    and isinstance(node.value, ast.Call)]
+        if len(literals) != 1:
+            raise ValueError('Unexpected protobuf schema layout')
+        pool.AddSerializedFile(ast.literal_eval(literals[0]))
+        hashes[name] = hashlib.sha256(raw).hexdigest()
+    response = message_factory.GetMessageClass(
+        pool.FindMessageTypeByName('Qot_UpdateKL.Response'))
+
+    def decode(payload):
+        message = response()
+        message.ParseFromString(payload)
+        if not message.IsInitialized() or message.retType != 0 or not message.HasField('s2c'):
+            raise ValueError('Invalid Qot_UpdateKL response')
+        s = message.s2c
+        if s.security.market != 11 or s.klType != 1 or s.rehabType != 1:
+            raise ValueError('Unsupported market/interval/adjustment flag')
+        rows = []
+        for k in s.klList:
+            # ListFields retains field presence, names and exact decoded values.
+            row = {field.name: value for field, value in k.ListFields()}
+            required = ('time', 'openPrice', 'highPrice', 'lowPrice',
+                        'closePrice', 'volume', 'turnover')
+            if any(key not in row for key in required):
+                raise ValueError('Missing candle fields')
+            prices = [row[key] for key in required[1:5]]
+            if (not all(math.isfinite(v) and v > 0 for v in prices)
+                    or not math.isfinite(k.turnover) or k.turnover < 0
+                    or k.volume < 0 or k.isBlank
+                    or not k.lowPrice <= min(k.openPrice, k.closePrice)
+                    <= max(k.openPrice, k.closePrice) <= k.highPrice):
+                raise ValueError('Invalid candle values')
+            rows.append(row)
+        if not 0 < len(rows) <= 100:
+            raise ValueError('Unexpected row count')
+        return 'US.' + s.security.code, rows
+
+    return decode, dict(sdk='10.11.7108', schema_source_sha256=hashes)
+
+
+def replay(directory, *, sequence=None, cutoff_ns=None, decoder=None):
+    """Verify the entire seal, decode all receipts, then select inclusive cutoffs.
+
+    Last means receipt sequence/row position, never greatest source timestamp.
+    Both cutoffs intersect. History includes repeats and all rows in wire order.
+    Raw journal records remain attached, including payloads and integrity hashes.
+    Returns detached data so a caller cannot alter another replay's history.
+    """
+    for name, value in (('sequence', sequence), ('cutoff_ns', cutoff_ns)):
+        if value is not None and (type(value) is not int or value < 0):
+            raise ValueError(f'{name} must be a nonnegative integer')
+    records = verify(directory)
+    identity = {'decoder': 'injected'}
+    if decoder is None:
+        decoder, identity = protobuf_decoder()
+    revisions = []
+    previous_wall = previous_mono = -1
+    for record in records:
+        wall, mono = record['received_wall_ns'], record['received_mono_ns']
+        if (type(wall) is not int or type(mono) is not int
+                or wall < previous_wall or mono < previous_mono):
+            raise ValueError('Invalid receipt ordering')
+        previous_wall, previous_mono = wall, mono
+        if record['payload_kind'] != 'SDK_PROTOBUF_SERIALIZATION':
+            raise ValueError('Unsupported payload kind')
+        symbol, rows = decoder(base64.b64decode(record['payload_b64'], validate=True))
+        if (symbol != record['symbol'] or not rows
+                or [row['time'] for row in rows] != record['source_stamps']):
+            raise ValueError('Decoded symbol/source label mismatch')
+        for index, row in enumerate(rows):
+            if not isinstance(row['time'], str) or not row['time']:
+                raise ValueError('Invalid source label')
+            revisions.append(dict(symbol=symbol, source_label=row['time'],
+                                  sequence=record['sequence'], row_index=index,
+                                  received_wall_ns=wall, received_mono_ns=mono,
+                                  source=copy.deepcopy(row), receipt=copy.deepcopy(record),
+                                  status='PROVISIONAL', finality='UNKNOWN',
+                                  strategy_status='DATA_BLOCKED'))
+    selected = [r for r in revisions
+                if (sequence is None or r['sequence'] <= sequence)
+                and (cutoff_ns is None or r['received_wall_ns'] <= cutoff_ns)]
+    groups = {}
+    for revision in selected:
+        key = revision['symbol'], revision['source_label']
+        groups.setdefault(key, []).append(revision)
+    return dict(schema=1, mode='OFFLINE_RECEIPT_REPLAY', status='PROVISIONAL',
+                finality='UNKNOWN', strategy_status='DATA_BLOCKED',
+                boundary_semantics='UNKNOWN', completeness='NOT_ESTABLISHED',
+                provider_accuracy='NOT_ESTABLISHED', adjustment_factors='UNKNOWN',
+                as_of=dict(sequence=sequence, received_wall_ns=cutoff_ns),
+                provenance=dict(decoder=identity, verified_receipts=len(records),
+                                replay_source_sha256=hashlib.sha256(
+                                    Path(__file__).read_bytes()).hexdigest(),
+                                verifier_source_sha256=hashlib.sha256(
+                                    Path(__file__).with_name('capture.py').read_bytes()).hexdigest(),
+                                verified_last_hash=records[-1]['hash'] if records else None,
+                                manifest_sha256=hashlib.sha256(
+                                    (Path(directory) / 'manifest.json').read_bytes()).hexdigest()),
+                receipts=[copy.deepcopy(r) for r in records
+                          if (sequence is None or r['sequence'] <= sequence)
+                          and (cutoff_ns is None or r['received_wall_ns'] <= cutoff_ns)],
+                revisions=selected,
+                groups=[dict(symbol=s, source_label=label, history=history,
+                             last_observed=copy.deepcopy(history[-1]),
+                             status='PROVISIONAL', finality='UNKNOWN',
+                             strategy_status='DATA_BLOCKED')
+                        for (s, label), history in groups.items()])
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('capture', type=Path)
+    parser.add_argument('--sequence', type=int)
+    parser.add_argument('--cutoff-ns', type=int, help='Inclusive receipt wall nanoseconds')
+    parser.add_argument('--output', type=Path, help='New exclusive JSON file; otherwise stdout')
+    args = parser.parse_args(argv)
+    try:
+        result = replay(args.capture, sequence=args.sequence, cutoff_ns=args.cutoff_ns)
+        encoded = json.dumps(result, indent=2, allow_nan=False) + '\n'
+        if args.output:
+            with args.output.open('x', encoding='utf-8') as handle:
+                handle.write(encoded)
+        else:
+            print(encoded, end='')
+    except Exception as exc:
+        # CLI boundary: protobuf/dependency failures must also report blocked,
+        # without emitting a partial view. Interrupts still propagate.
+        print(f'DATA_BLOCKED: replay failed: {exc}', file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/research/feed_contract/receipt_quality.py b/research/feed_contract/receipt_quality.py
new file mode 100644
index 0000000..d2cd030
--- /dev/null
+++ b/research/feed_contract/receipt_quality.py
@@ -0,0 +1,85 @@
+"""Strictly offline observations of provisional candle receipt evidence."""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+from provisional_replay import replay
+
+
+def report(directory, *, sequence=None, cutoff_ns=None, decoder=None):
+    """Verify/decode entire sealed journal before summarizing selected evidence.
+
+    Receipt gaps are monotonic-clock deltas, never inferred missing candles.
+    Repeated observations include all rows; changes compare decoded field presence
+    and values, not protobuf byte identity. Raw evidence stays in the journal.
+    """
+    view = replay(directory, sequence=sequence, cutoff_ns=cutoff_ns, decoder=decoder)
+    safety = dict(status='PROVISIONAL', finality='UNKNOWN', strategy_status='DATA_BLOCKED')
+    groups = []
+    for g in view['groups']:
+        history = g['history']
+        fields = Counter()
+        changed = 0
+        for previous, current in zip(history, history[1:]):
+            a, b = previous['source'], current['source']
+            keys = [k for k in sorted(a.keys() | b.keys())
+                    if (k in a) != (k in b) or a.get(k) != b.get(k)]
+            fields.update(keys)
+            changed += bool(keys)
+        groups.append(dict(symbol=g['symbol'], source_label=g['source_label'],
+                           observations=len(history), changed_transitions=changed,
+                           identical_transitions=len(history)-1-changed,
+                           changed_fields=dict(fields),
+                           first_sequence=history[0]['sequence'],
+                           last_sequence=history[-1]['sequence'], **safety))
+    symbols = []
+    for symbol in dict.fromkeys(r['symbol'] for r in view['receipts']):
+        receipts = [r for r in view['receipts'] if r['symbol'] == symbol]
+        gaps = [dict(from_sequence=a['sequence'], to_sequence=b['sequence'],
+                     elapsed_mono_ns=b['received_mono_ns']-a['received_mono_ns'])
+                for a, b in zip(receipts, receipts[1:])]
+        symbols.append(dict(symbol=symbol, receipts=len(receipts),
+                            unique_observed_labels=sum(g['symbol'] == symbol for g in groups),
+                            first_received_wall_ns=receipts[0]['received_wall_ns'],
+                            last_received_wall_ns=receipts[-1]['received_wall_ns'],
+                            observation_span_mono_ns=receipts[-1]['received_mono_ns']-receipts[0]['received_mono_ns'],
+                            interreceipt_gaps=gaps,
+                            max_interreceipt_mono_ns=max((g['elapsed_mono_ns'] for g in gaps), default=None),
+                            **safety))
+    return dict(schema=1, mode='OFFLINE_CANDLE_QUALITY', **safety,
+                completeness='NOT_ESTABLISHED', boundary_semantics='UNKNOWN',
+                provider_accuracy='NOT_ESTABLISHED', adjustment_factors='UNKNOWN',
+                as_of=view['as_of'], provenance=dict(view['provenance'],
+                    quality_source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()),
+                selected_receipts=len(view['receipts']), selected_rows=len(view['revisions']),
+                groups=groups, symbols=symbols,
+                limitations='Observed receipts only. No expected cadence, missing-minute inference, '
+                'session coverage ratio, finality, completeness or strategy eligibility established.')
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('capture', type=Path)
+    parser.add_argument('--sequence', type=int)
+    parser.add_argument('--cutoff-ns', type=int)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args(argv)
+    try:
+        result = report(args.capture, sequence=args.sequence, cutoff_ns=args.cutoff_ns)
+        encoded = json.dumps(result, indent=2, allow_nan=False) + '\n'
+        if args.output:
+            with args.output.open('x', encoding='utf-8') as handle:
+                handle.write(encoded)
+        else:
+            print(encoded, end='')
+    except Exception as exc:
+        print(f'DATA_BLOCKED: quality report failed: {exc}', file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
